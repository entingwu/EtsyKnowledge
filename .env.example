#.env

# ====================
# MinerU API
# ====================
MINERU_API_TOKEN=your-key-here
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# OpenAI / LLM API
# ====================
# API 密钥
OPENAI_API_KEY=your-key-here
# API 基础地址（阿里云 DashScope）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL_DASHSCOPE=https://dashscope.aliyuncs.com/api/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=qwen3-vl-flash
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=127.0.0.1:9100
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=etsy-kb
# 图片上传目录
MINIO_IMG_DIR=upload-images

DEBUG=False

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=/path/to/models/bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
BGE_DEVICE=mps
# 是否使用半精度（True/False）1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=True

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://127.0.0.1:19540
# 知识库切片集合名
CHUNKS_COLLECTION=etsy_kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=etsy_kb_item_names

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://<user>:<password>@127.0.0.1:27018
# 数据库名
MONGO_DB_NAME=etsy_kb

# ====================
# MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ====================
# 重排序模型
# ====================
TEXT_RERANK_MODEL=qwen3-rerank
#TEXT_RERANK_INSTRUCT='Given a web search query, retrieve relevant passages that answer the query.'
TEXT_RERANK_INSTRUCT='Retrieve semantically similar text.'

# ====================
# 数据根目录
# ====================
DATA_BASED_ROOT_DIR=/path/to/project/data

# ====================
# 测试：.env 与系统环境变量的优先级（第3章）
# ====================
MY_KEY=dotenv_val
